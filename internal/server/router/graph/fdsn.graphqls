type fdsnAccessKey {
  keyId: String!
  keyPrefix: String!
  remark: String!
  createdAt: Int64!
  expiresAt: Int64
  revokedAt: Int64
  lastRequestedAt: Int64
  userIp: String!
  userAgent: String!
}

type createdFDSNAccessKey {
  accessKey: fdsnAccessKey!
  key: String! # Returned only once; the database stores a SHA-256 hash.
}

extend type Query {
  getFDSNAccessKeys: [fdsnAccessKey!]! # admin only
}

extend type Mutation {
  # FDSN access management - admin only; timestamps are Unix milliseconds
  createFDSNAccessKey(remark: String!, expiresAt: Int64): createdFDSNAccessKey!
  revokeFDSNAccessKeys(keyIds: [String!]!): Boolean!
}
