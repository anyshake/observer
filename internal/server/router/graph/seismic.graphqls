type _channelData {
  channelCode: String!
  channelId: Int!
  data: [Int32!]!
  inputUnit: String!
  "Counts per input unit at recording time, zero when unavailable"
  sensitivity: Float!
  "Peak ground acceleration of this record in m/s^2, null without metadata"
  pga: Float
  "Peak ground velocity of this record in m/s, null without metadata"
  pgv: Float
  "Peak ground displacement of this record in m, null without metadata"
  pgd: Float
}

type seisRecord {
  timestamp: Int64!
  sampleRate: Int!
  channelData: [_channelData!]!
}

type seisEventSource {
  id: String!
  country: String!
  locales: Map!
  defaultLocale: String!
}

type seisEvent {
  verfied: Boolean!
  timestamp: Int64!
  eventId: String!
  region: String!
  depth: Float!
  latitude: Float!
  longitude: Float!
  magnitude: Map!
  distance: Float!
  estimation: [Float!]! # [P-wave travel time, S-wave travel time] in seconds; -1 means unavailable
}

extend type Query {
  getEventSource: [seisEventSource]!
  getEventsBySource(code: String!): [seisEvent!]!
  getSeisRecordsByTime(startTime: Int64!, endTime: Int64!): [seisRecord]!
}
